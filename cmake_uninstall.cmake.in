if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
    message(
        FATAL_ERROR
        "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt"
    )
endif()

file(
    STRINGS
    "@CMAKE_BINARY_DIR@/install_manifest.txt"
    installed_files
)

foreach(installed_file IN LISTS installed_files)
    set(path "$ENV{DESTDIR}${installed_file}")

    if(IS_SYMLINK "${path}" OR EXISTS "${path}")
        message(STATUS "Uninstalling ${path}")

        execute_process(
            COMMAND
                "@CMAKE_COMMAND@" -E rm -f "${path}"
            RESULT_VARIABLE result
        )

        if(NOT result EQUAL 0)
            message(
                FATAL_ERROR
                "Failed to remove ${path}"
            )
        endif()
    else()
        message(STATUS "File ${path} does not exist")
    endif()
endforeach()
